# MediCare Hospital - Environment Configuration Template
PORT=3000

# Supabase PostgreSQL Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API (or API Keys)
# SUPABASE_URL: Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE_SECRET_KEY: Secret key (or service_role secret key)
# IMPORTANT: This key MUST NEVER be exposed in client-side / public JavaScript.
# Keep this file and your .env strictly on the backend.
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key
